{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Alfredo-Sandoval/mlx-mcp",
  "description": "Search the MLX, MLX Data and MLX LM docs from Claude Code, Codex or any MCP client",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mlx-mcp",
      "version": "0.1.1",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--python",
          "value": "3.13"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
